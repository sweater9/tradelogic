[Unit]
Description=TradeLogic trading engine
After=network-online.target
Wants=network-online.target
# When IBKR is enabled, also start after your TWS/IB Gateway service, e.g.:
# After=ibgateway.service

[Service]
Type=simple
User=tradelogic
Group=tradelogic
WorkingDirectory=/opt/tradelogic
EnvironmentFile=/opt/tradelogic/.env
Environment=TRADELOGIC_DB=/var/lib/tradelogic/tradelogic.db
Environment=TZ=America/New_York
ExecStart=/opt/tradelogic/.venv/bin/python -m tradelogic -c /opt/tradelogic/config.yaml run
Restart=always
RestartSec=10
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradelogic
StateDirectory=tradelogic

[Install]
WantedBy=multi-user.target
